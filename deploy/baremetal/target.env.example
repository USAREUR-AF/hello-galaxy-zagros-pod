# Copy to target.env (gitignored) and point it at YOUR on-prem host.
HOST=10.0.0.50               # the host you SSH to (IP or name)
SSH_USER=ubuntu             # a sudo-capable user on it
SSH_KEY=~/.ssh/id_ed25519   # your SSH private key

# Optional — defaults reuse the shared parent-dir artifacts the cloud path also uses:
# BUNDLE_DIR=../bundle       # dir with cert.pem / key.pem / ca.pem from your signed bundle
# POD_ENV=../pod.env         # SETUP_KEY / MGMT_URL / ROUTER_ENDPOINT / SLOT
