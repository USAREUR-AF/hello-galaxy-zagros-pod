# Profile: zagros (a sandbox-shaped goatnet — per-uuid slot-pool fabric; the shape described in
# usareur-af/zagros-moon-pod). Point it at the goatnet you are using via the signed join bundle.
#
# This is the LIVE path for the example partner — Velmara Autonomous Systems Command. It is
# distinct from the laptop loopback (run.sh), which is self-contained and reads its values from
# stack/registry/fabric.yaml. Here the values come from the signed join bundle minted for the
# partner at onboarding; this file only carries fallbacks the bundle doesn't.
#
# Fallback values for standing the pod up against a zagros-shaped goatnet. That shape is a
# SANDBOX (not the production shape): enrollment is netbird setup-key based and the Zenoh write
# namespace is a per-uuid SLOT (not release/<partner>). None of this is canon; production deltas
# come from the production profile + the signed bundle.
#
# The partner receives a netbird setup-key + a Zenoh slot cert in a signed join bundle from the
# operator onboarding flow. The BUNDLE is the source of truth: first-boot reads the router
# endpoint and the mTLS identity straight from it. The values below are only fallbacks for
# hand-driven validation when a field is absent from the bundle.

# --- Mesh client ---
# A zagros-shaped goatnet runs no silent control plane; enrollment is a netbird setup-key, so
# the cleaner partner on-ramp is netbird-only.
GOAT_CLIENT_MODE=netbird-only

# --- Zenoh ---
# Endpoint the pod's router dials. The bundle's router_endpoint WINS when present; this is only
# the fallback for hand-driven validation. The router cert carries a matching DNS SAN so the pod
# can keep verify_name_on_connect.
ZENOH_FABRIC_ENDPOINT=tls/zenoh.goatnet.example:7447
ZENOH_LOCAL_ENDPOINT=tls/127.0.0.1:7447

# ACL subject identity axis. On a zagros-shaped goatnet the cert CN, the portal prefix, and the write
# namespace are ALL the uuid slot anchor (slot_id); the baked ACL keys write rules off the cert
# CN, so the axis is cert_common_names.
ZENOH_ACL_SUBJECT_AXIS=cert_common_names
# Pod's cert CN on a zagros-shaped fabric = the uuid slot the portal assigns at onboarding (NOT a
# human-readable name). Fill from the onboarding response (slot_id / uri_san). The requested
# prefix is ignored by the per-uuid portal.
ZENOH_POD_CN=CHANGE-ME-zagros-uuid-slot

# --- Namespace ---
# The zagros-shaped write namespace is the per-uuid slot anchor: the pod may only write <slot_id>/**. There is
# no release/<partner>/ grant on the sandbox; a publish outside <slot_id>/ is silently denied.
# Set this to the slot_id the portal assigned at onboarding.
PARTNER_NAMESPACE=CHANGE-ME-zagros-uuid-slot
# Bilateral inbound prefix the fabric publishes TO the pod. On the sandbox there is no separate
# bilateral grant yet, so this defaults to the pod's own slot (first-boot falls back to
# PARTNER_NAMESPACE when unset). Set it only once a bilateral inbound channel is granted.
# INBOUND_NAMESPACE=

# --- Audit ---
AUDIT_RETENTION_DAYS=90

# --- PKI ---
# CA trust comes from the bundle (ca_roots) / --trust-roots — never compiled in.
